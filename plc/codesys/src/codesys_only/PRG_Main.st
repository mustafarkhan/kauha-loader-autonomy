(* Main program of the testbed safety PLC. Run it in a cyclic task of 25 ms
   (Task configuration: "SafetyTask", cyclic, t#25ms, priority 1, watchdog 50 ms).

   Choose the configuration list for the profile that matches the hardware:
     CFG_SCALE8_EVALUATOR  hobby lidar + software field evaluator (first tests)
     CFG_SCALE8_NANOSCAN3  rated SICK nanoScan3 I/O scanners (set USE_SCANNER_IO := TRUE)
     CFG_FULL              the full-size machine (reference only)
   The profiles are generated by `python -m kauha.scale.profile` from the same
   numbers the twin and the proofs use. *)

PROGRAM PRG_Main
VAR
    can  : FB_CanPort;
    node : FB_SafetyNode;
    t    : LREAL;
    relayCheck : TON;          (* a stop must be followed by both relays dropping *)
    xRelayFault : BOOL;
END_VAR

t := TIME_TO_LREAL(TIME()) / 1000.0;

can(xReceive := TRUE, xSend := FALSE);

node(cfg := CFG_SCALE8_EVALUATOR,
     t := t,
     rx := can.rx,
     estop_chain_ok := GVL_IO.xEstopChainOk AND NOT xRelayFault,
     use_scanner_io := GVL_IO.USE_SCANNER_IO,
     scanner_io := GVL_IO.stScannerIO);

GVL_IO.xDriveEnable := node.drive_enable;
GVL_IO.xImplementEnable := node.implement_enable;
GVL_IO.xRunLamp := node.drive_enable;
GVL_IO.xFs0 := (node.field_set_code AND 16#01) <> 0;
GVL_IO.xFs1 := (node.field_set_code AND 16#02) <> 0;
GVL_IO.xFs2 := (node.field_set_code AND 16#04) <> 0;
GVL_IO.xFs3 := (node.field_set_code AND 16#08) <> 0;
GVL_IO.xFs4 := (node.field_set_code AND 16#10) <> 0;
GVL_IO.xFs5 := (node.field_set_code AND 16#20) <> 0;

(* Relay monitoring: with both coils off, the mirror contacts must close within 100 ms.
   A welded contact latches a fault that reads as an e-stop until power cycle. *)
relayCheck(IN := NOT GVL_IO.xDriveEnable AND NOT GVL_IO.xImplementEnable AND NOT GVL_IO.xRelayFeedbackOk,
           PT := T#100MS);
IF relayCheck.Q THEN
    xRelayFault := TRUE;
END_IF

can(xReceive := FALSE, xSend := TRUE, tx_id := node.tx_id, tx := node.tx);
END_PROGRAM
